<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chi tiết đơn hàng - Sweetie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #fff;
            color: #111827;
        }

        .header {
            background: #fff4f8;
            padding: 18px 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 34px;
            font-weight: bold;
            color: #e91e63;
            text-decoration: none;
        }

        .nav {
            display: flex;
            gap: 40px;
        }

        .nav a {
            text-decoration: none;
            color: #111827;
            font-size: 17px;
        }

        .container-main {
            max-width: 1200px;
            margin: 50px auto;
            padding: 0 20px;
        }

        .title {
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 30px;
        }

        .order-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 35px;
        }

        .info-row {
            display: flex;
            margin-bottom: 14px;
            font-size: 18px;
        }

        .label {
            width: 220px;
            color: #6b7280;
        }

        .value {
            color: #111827;
        }

        .status {
            display: inline-block;
            background: #ffe5ee;
            color: #e91e63;
            padding: 7px 18px;
            border-radius: 20px;
            font-weight: 600;
        }

        .section-title {
            margin-top: 35px;
            margin-bottom: 20px;
            font-size: 28px;
            font-weight: 700;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #ddd;
        }

        th {
            background: #f5f6f8;
            padding: 16px;
            text-align: left;
        }

        td {
            padding: 16px;
            border-top: 1px solid #ddd;
        }

        th:first-child,
        td:first-child {
            text-align: center;
            width: 80px;
        }

        .total-box {
            margin-top: 20px;
            padding: 20px 25px;
            background: #fff0f5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 6px;
        }

        .total-label {
            font-size: 24px;
            font-weight: bold;
        }

        .total-price {
            font-size: 30px;
            font-weight: bold;
            color: #e91e63;
        }

        .back-btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            border: 1px solid #ccc;
            border-radius: 6px;
            text-decoration: none;
            color: #111827;
        }

        .back-btn:hover {
            background: #fff0f5;
            color: #e91e63;
        }
        .status {
    display: inline-block;
    padding: 7px 18px;
    border-radius: 20px;
    font-weight: 600;
}

/* Chờ xác nhận */
.status-cho-xac-nhan {
    background: #fff3cd;
    color: #856404;
}

/* Đang xử lý */
.status-dang-xu-ly {
    background: #dbeafe;
    color: #1d4ed8;
}

/* Đang giao */
.status-dang-giao {
    background: #e0f2fe;
    color: #0369a1;
}

/* Hoàn thành */
.status-hoan-thanh {
    background: #dcfce7;
    color: #15803d;
}

/* Đã hủy */
.status-da-huy {
    background: #fee2e2;
    color: #dc2626;
}
    </style>
</head>

<body>

<header class="header">

    <a href="/" class="logo">
        🧁 Sweetie
    </a>

    <div class="nav">
        <a href="/">Trang chủ</a>
        <a href="/san-pham">Sản phẩm</a>
        <a href="/gioi-thieu">Giới thiệu</a>
        <a href="/lien-he">Liên hệ</a>
        <a href="/gio-hang">🛒</a>
    </div>

</header>


<main class="container-main">

    <h1 class="title">
        Chi tiết đơn hàng
        #<%= donHang._id.toString().slice(-6).toUpperCase() %>
    </h1>


    <div class="order-card">

        <div class="info-row">
            <div class="label">
                Mã đơn hàng:
            </div>

            <div class="value">
                #<%= donHang._id.toString().slice(-6).toUpperCase() %>
            </div>
        </div>


        <div class="info-row">
            <div class="label">
                Ngày đặt:
            </div>

            <div class="value">
                <%= new Date(donHang.ngayDat).toLocaleString("vi-VN") %>
            </div>
        </div>


        <div class="info-row">
            <div class="label">
                Khách hàng:
            </div>

            <div class="value">
                <%= donHang.hoTen %>
            </div>
        </div>


        <div class="info-row">
            <div class="label">
                Số điện thoại:
            </div>

            <div class="value">
                <%= donHang.soDienThoai %>
            </div>
        </div>


        <div class="info-row">
            <div class="label">
                Địa chỉ:
            </div>

            <div class="value">
                <%= donHang.diaChi %>
            </div>
        </div>


        <div class="info-row">
            <div class="label">
                Trạng thái:
            </div>

            <div class="value">
                <%
    let statusClass = "";

    if (donHang.trangThai === "Chờ xác nhận") {
        statusClass = "status-cho-xac-nhan";
    }
    else if (donHang.trangThai === "Đang xử lý") {
        statusClass = "status-dang-xu-ly";
    }
    else if (donHang.trangThai === "Đang giao") {
        statusClass = "status-dang-giao";
    }
    else if (donHang.trangThai === "Hoàn thành") {
        statusClass = "status-hoan-thanh";
    }
    else if (donHang.trangThai === "Đã hủy") {
        statusClass = "status-da-huy";
    }
%>

<span class="status <%= statusClass %>">
    <%= donHang.trangThai %>
</span>
            </div>
        </div>


        <h2 class="section-title">
            Sản phẩm
        </h2>


        <div style="overflow-x: auto;">

            <table>

                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Tên sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>


                <tbody>

                    <% if (chiTietDonHang && chiTietDonHang.length > 0) { %>

                        <% chiTietDonHang.forEach(function(item, index) { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>

                                <td>
                                    <% if (item.sanPhamId) { %>

                                        <%= item.sanPhamId.tenSanPham %>

                                    <% } else { %>

                                        Sản phẩm đã bị xóa

                                    <% } %>
                                </td>

                                <td>
                                    <%= item.soLuong %>
                                </td>

                                <td>
                                    <%= Number(item.donGia || 0).toLocaleString("vi-VN") %>đ
                                </td>

                                <td>
                                    <%= Number(item.thanhTien || 0).toLocaleString("vi-VN") %>đ
                                </td>

                            </tr>

                        <% }); %>

                    <% } else { %>

                        <tr>
                            <td colspan="5" style="text-align:center;">
                                Không có sản phẩm trong đơn hàng
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>


        <div class="total-box">

            <div class="total-label">
                Tổng cộng
            </div>

            <div class="total-price">
                <%= Number(donHang.tongTien || 0).toLocaleString("vi-VN") %>đ
            </div>

        </div>

    </div>


    <a href="/don-hang" class="back-btn">
        ← Quay lại
    </a>

</main>

</body>
</html>