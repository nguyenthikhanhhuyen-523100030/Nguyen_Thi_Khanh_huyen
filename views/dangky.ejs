<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Đăng ký - Sweetie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        body {
            margin: 0;
            background: #ffffff;
            font-family: Arial, Helvetica, sans-serif;
            color: #111827;
        }

        /* HEADER */
        .header {
            height: 82px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #f3f3f3;
            background: #fff;
        }

        .header-inner {
            width: 100%;
            max-width: 1400px;
            margin: auto;
            display: flex;
            align-items: center;
            gap: 40px;
            padding: 0 30px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #ef2b67;
            min-width: 220px;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #fff0f5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .logo-text {
            font-size: 36px;
            font-weight: 700;
            font-style: italic;
        }

        .menu {
            display: flex;
            gap: 36px;
            align-items: center;
        }

        .menu a {
            text-decoration: none;
            color: #111827;
            font-size: 16px;
        }

        .menu a:hover {
            color: #ef2b67;
        }

        .search-box {
            margin-left: auto;
            width: 370px;
            height: 50px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            display: flex;
            align-items: center;
            padding: 0 15px;
        }

        .search-box input {
            border: none;
            outline: none;
            width: 100%;
            margin-left: 10px;
            font-size: 16px;
        }

        .header-icons {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 27px;
        }

        .header-icons a {
            color: #111;
            text-decoration: none;
        }

        /* FORM */
        .dangky-wrapper {
            min-height: calc(100vh - 82px);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 75px 20px;
        }

        .dangky-box {
            width: 100%;
            max-width: 650px;
            background: #fff;
            border: 1px solid #eeeeee;
            border-radius: 15px;
            padding: 45px 42px 35px;
            box-shadow: 0 2px 7px rgba(0,0,0,0.03);
        }

        .dangky-title {
            text-align: center;
            margin-bottom: 34px;
        }

        .dangky-title h1 {
            font-size: 40px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .dangky-title p {
            font-size: 18px;
            color: #6b7280;
            margin: 0;
        }

        .form-label {
            font-size: 17px;
            font-weight: 500;
            margin-bottom: 9px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 22px;
        }

        .input-group-custom i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            font-size: 18px;
            z-index: 2;
        }

        .input-group-custom input,
        .input-group-custom textarea {
            width: 100%;
            border: 1px solid #d9dce1;
            border-radius: 10px;
            font-size: 16px;
            outline: none;
            transition: 0.2s;
        }

        .input-group-custom input {
            height: 60px;
            padding: 0 18px 0 52px;
        }

        .input-group-custom textarea {
            min-height: 100px;
            padding: 17px 18px 17px 52px;
            resize: none;
        }

        .input-group-custom textarea + i {
            top: 22px;
            transform: none;
        }

        .input-group-custom input:focus,
        .input-group-custom textarea:focus {
            border-color: #ef2b67;
            box-shadow: 0 0 0 3px rgba(239, 43, 103, 0.08);
        }

        .btn-dangky {
            width: 100%;
            height: 62px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #f32769, #f13979);
            color: white;
            font-size: 20px;
            font-weight: 600;
            margin-top: 7px;
        }

        .btn-dangky:hover {
            opacity: 0.92;
        }

        .duong-ngang {
            display: flex;
            align-items: center;
            gap: 18px;
            color: #6b7280;
            margin: 28px 0 22px;
        }

        .duong-ngang::before,
        .duong-ngang::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #ededed;
        }

        .dangnhap-text {
            text-align: center;
            color: #6b7280;
            font-size: 16px;
        }

        .dangnhap-text a {
            color: #ef2b67;
            font-weight: 600;
        }

        .alert {
            border-radius: 10px;
        }

        @media (max-width: 992px) {
            .menu,
            .search-box {
                display: none;
            }

            .logo {
                min-width: auto;
            }

            .header-inner {
                justify-content: space-between;
            }
        }
    </style>
</head>

<body>

<header class="header">
    <div class="header-inner">

        <a href="/" class="logo">
            <div class="logo-icon">
                🧁
            </div>

            <div class="logo-text">
                Sweetie
            </div>
        </a>

        <nav class="menu">
            <a href="/">Trang chủ</a>
            <a href="/san-pham">Sản phẩm</a>
            <a href="/danh-muc">Danh mục</a>
            <a href="#">Giới thiệu</a>
            <a href="#">Liên hệ</a>
        </nav>

        <form action="/san-pham" method="GET" class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input
                type="text"
                name="tuKhoa"
                placeholder="Tìm kiếm sản phẩm..."
            >
        </form>

        <div class="header-icons">
            <a href="/dang-nhap">
                <i class="fa-regular fa-user"></i>
            </a>

            <a href="/gio-hang">
                <i class="fa-solid fa-cart-shopping"></i>
            </a>
        </div>

    </div>
</header>


<main class="dangky-wrapper">

    <div class="dangky-box">

        <div class="dangky-title">

            <h1>Đăng ký</h1>

            <p>
                Tạo tài khoản để mua bánh tại Sweetie!
            </p>

        </div>


        <% if (typeof thongBao !== "undefined" && thongBao) { %>

            <div class="alert alert-danger">
                <%= thongBao %>
            </div>

        <% } %>


        <form action="/dang-ky" method="POST">

            <!-- HỌ TÊN -->

            <label class="form-label">
                Họ và tên
            </label>

            <div class="input-group-custom">

                <i class="fa-regular fa-user"></i>

                <input
                    type="text"
                    name="hoTen"
                    placeholder="Nhập họ và tên của bạn"
                    required
                >

            </div>


            <!-- EMAIL -->

            <label class="form-label">
                Email
            </label>

            <div class="input-group-custom">

                <i class="fa-regular fa-envelope"></i>

                <input
                    type="email"
                    name="email"
                    placeholder="Nhập email của bạn"
                    required
                >

            </div>


            <!-- MẬT KHẨU -->

            <label class="form-label">
                Mật khẩu
            </label>

            <div class="input-group-custom">

                <i class="fa-solid fa-lock"></i>

                <input
                    type="password"
                    name="matKhau"
                    placeholder="Nhập mật khẩu"
                    required
                >

            </div>


            <!-- SỐ ĐIỆN THOẠI -->

            <label class="form-label">
                Số điện thoại
            </label>

            <div class="input-group-custom">

                <i class="fa-solid fa-phone"></i>

                <input
                    type="text"
                    name="soDienThoai"
                    placeholder="Nhập số điện thoại"
                >

            </div>


            <!-- ĐỊA CHỈ -->

            <label class="form-label">
                Địa chỉ
            </label>

            <div class="input-group-custom">

                <textarea
                    name="diaChi"
                    placeholder="Nhập địa chỉ nhận hàng"
                ></textarea>

                <i class="fa-solid fa-location-dot"></i>

            </div>


            <button
                type="submit"
                class="btn-dangky"
            >
                Đăng ký
            </button>

        </form>


        <div class="duong-ngang">
            hoặc
        </div>


        <div class="dangnhap-text">

            Đã có tài khoản?

            <a href="/dang-nhap">
                Đăng nhập ngay
            </a>

        </div>

    </div>

</main>

</body>
</html>