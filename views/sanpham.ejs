<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sản phẩm - Sweetie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #fff;
            color: #111827;
        }
.header {
    height: 82px;
    background: #fff;
    border-bottom: 1px solid #f2f2f2;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.header-inner {
    width: 100%;
    max-width: 1400px;
    margin: auto;
    padding: 0 30px;

    display: flex;
    align-items: center;

    gap: 28px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    text-decoration: none;
    color: #ef2b67;

    min-width: 250px;
    flex-shrink: 0;
}

.logo-icon {
    width: 50px;
    height: 50px;

    background: #fff0f5;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 27px;
}

.logo-text {
    font-size: 36px;
    font-weight: 700;
    font-style: italic;

    white-space: nowrap;
}

.menu {
    display: flex;
    align-items: center;

    gap: 28px;

    flex-shrink: 0;
}

.menu a {
    text-decoration: none;
    color: #111827;

    font-size: 16px;

    position: relative;

    padding: 30px 0;

    /* Không cho chữ xuống dòng */
    white-space: nowrap;
}

.menu a:hover,
.menu a.active {
    color: #ef2b67;
}

.menu a.active::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;

    bottom: 18px;

    height: 2px;

    background: #ef2b67;
}

.search-box {
    margin-left: auto;

    width: 280px;
    min-width: 230px;
    height: 50px;

    border: 1px solid #e5e7eb;
    border-radius: 10px;

    display: flex;
    align-items: center;

    padding: 0 15px;

    background: white;
}

.search-box input {
    border: none;
    outline: none;

    width: 100%;

    margin-left: 12px;

    font-size: 16px;
}
        .search-box input {
            border: none;
            outline: none;
            flex: 1;
            margin-left: 12px;
            font-size: 16px;
        }
        .header-icons {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 27px;
        }

        .header-icons a {
            color: #111;
            text-decoration: none;
        }

        .cart-box {
            position: relative;
        }

        .cart-count {
            position: absolute;
            right: -10px;
            top: -10px;
            background: #ef2b67;
            color: white;
            font-size: 11px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* MAIN */
        .noi-dung {
            max-width: 1400px;
            margin: auto;
            padding: 25px 30px 60px;
        }

        .breadcrumb-custom {
            color: #6b7280;
            margin-bottom: 12px;
        }

        .breadcrumb-custom a {
            color: #6b7280;
            text-decoration: none;
        }

        .breadcrumb-custom span {
            margin: 0 8px;
        }

        .tieu-de h1 {
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .tieu-de p {
            color: #6b7280;
            font-size: 17px;
            margin-bottom: 30px;
        }

        /* BỘ LỌC */
        .bo-loc {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
        }

        .bo-loc select,
        .bo-loc input {
            height: 45px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 0 12px;
        }

        .btn-loc {
            border: none;
            background: #ef2b67;
            color: white;
            padding: 0 22px;
            border-radius: 8px;
            font-weight: 600;
        }

        /* CARD */
        .san-pham-card {
            border: 1px solid #eeeeee;
            border-radius: 8px;
            overflow: hidden;
            background: #fff;
            height: 100%;
            transition: 0.2s;
        }

        .san-pham-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

        .anh-san-pham {
            width: 100%;
            height: 245px;
            object-fit: cover;
            display: block;
        }

        .thong-tin {
            padding: 15px 16px 16px;
        }

        .ten-san-pham {
            display: block;
            font-size: 18px;
            font-weight: 700;
            color: #111827;
            text-decoration: none;
            margin-bottom: 8px;
        }

        .ten-san-pham:hover {
            color: #ef2b67;
        }

        .gia {
            color: #ef2b67;
            font-size: 21px;
            font-weight: 700;
            margin-bottom: 13px;
        }

        .btn-gio {
            border: none;
            background: linear-gradient(90deg, #f32769, #f13979);
            color: white;
            min-width: 190px;
            height: 48px;
            border-radius: 7px;
            font-size: 16px;
            font-weight: 500;
        }

        .btn-gio i {
            margin-right: 9px;
        }

        .btn-gio:hover {
            opacity: 0.9;
        }

        .khong-co {
            text-align: center;
            color: #6b7280;
            padding: 60px 0;
            font-size: 18px;
        }

        @media (max-width: 1100px) {
            .search-box {
                width: 280px;
            }

            .menu {
                gap: 20px;
            }
        }

        @media (max-width: 900px) {
            .menu,
            .search-box {
                display: none;
            }

            .header-inner {
                justify-content: space-between;
            }

            .logo {
                min-width: auto;
            }
        }
    </style>
</head>

<body>

<header class="header">
    <div class="header-inner">

        <a href="/" class="logo">
            <div class="logo-icon">🧁</div>
            <div class="logo-text">Sweetie</div>
        </a>

        <nav class="menu">
            <a href="/">Trang chủ</a>
            <a href="/san-pham" class="active">Sản phẩm</a>
            <a href="#">Giới thiệu</a>
            <a href="#">Liên hệ</a>
        </nav>

        <form action="/san-pham" method="GET" class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input
                type="text"
                name="tuKhoa"
                value="<%= typeof tuKhoa !== 'undefined' ? tuKhoa : '' %>"
                placeholder="Tìm kiếm sản phẩm..."
            >

            <% if (typeof danhMuc !== "undefined" && danhMuc) { %>
                <input type="hidden" name="danhMuc" value="<%= danhMuc %>">
            <% } %>
        </form>

        <div class="header-icons">

            <a href="/dang-nhap">
                <i class="fa-regular fa-user"></i>
            </a>

            <a href="/gio-hang" class="cart-box">
                <i class="fa-solid fa-cart-shopping"></i>
                <span class="cart-count">0</span>
            </a>

        </div>

    </div>
</header>


<main class="noi-dung">

    <div class="breadcrumb-custom">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <strong>Sản phẩm</strong>
    </div>

    <div class="tieu-de">
        <h1>Danh sách sản phẩm</h1>

        <p>
            Khám phá những chiếc bánh ngọt ngào, được làm từ nguyên liệu tươi ngon nhất.
        </p>
    </div>


    <!-- LỌC DANH MỤC -->

    <form action="/san-pham" method="GET" class="bo-loc">

        <input
            type="text"
            name="tuKhoa"
            value="<%= typeof tuKhoa !== 'undefined' ? tuKhoa : '' %>"
            placeholder="Tên sản phẩm..."
        >

        <select name="danhMuc">

            <option value="">
                Tất cả danh mục
            </option>

            <% danhMucs.forEach(function(dm) { %>

                <option
                    value="<%= dm._id %>"
                    <%= typeof danhMuc !== "undefined" &&
                        danhMuc == dm._id.toString()
                        ? "selected"
                        : ""
                    %>
                >
                    <%= dm.tenDanhMuc %>
                </option>

            <% }) %>

        </select>

        <button type="submit" class="btn-loc">
            Lọc sản phẩm
        </button>

    </form>


    <div class="row g-4">

        <% if (!sanPhams || sanPhams.length === 0) { %>

            <div class="col-12">
                <div class="khong-co">
                    Chưa có sản phẩm phù hợp.
                </div>
            </div>

        <% } %>


        <% sanPhams.forEach(function(sp) { %>

            <div class="col-xl-3 col-lg-4 col-md-6">

                <div class="san-pham-card">

                    <a href="/san-pham/<%= sp._id %>">

                        <img
                            src="<%= sp.hinhAnh || 'https://via.placeholder.com/500x350?text=Banh+ngot' %>"
                            alt="<%= sp.tenSanPham %>"
                            class="anh-san-pham"
                        >

                    </a>


                    <div class="thong-tin">

                        <a
                            href="/san-pham/<%= sp._id %>"
                            class="ten-san-pham"
                        >
                            <%= sp.tenSanPham %>
                        </a>


                        <div class="gia">
                            <%= sp.gia.toLocaleString("vi-VN") %>đ
                        </div>


                        <form
                            action="/gio-hang/them/<%= sp._id %>"
                            method="POST"
                        >

                            <input
                                type="hidden"
                                name="soLuong"
                                value="1"
                            >

                            <button
                                type="submit"
                                class="btn-gio"
                            >
                                <i class="fa-solid fa-cart-shopping"></i>
                                Thêm vào giỏ
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</main>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>