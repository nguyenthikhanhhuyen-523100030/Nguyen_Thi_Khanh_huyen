<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Đăng nhập - Sweetie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        body {
            margin: 0;
            background: #ffffff;
            font-family: Arial, Helvetica, sans-serif;
            color: #111827;
        }

        /* HEADER */
        .header {
            height: 82px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #f3f3f3;
            background: #fff;
        }

        .header-inner {
            width: 100%;
            max-width: 1400px;
            margin: auto;
            display: flex;
            align-items: center;
            gap: 40px;
            padding: 0 30px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #ef2b67;
            min-width: 220px;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #fff0f5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .logo-text {
            font-size: 36px;
            font-weight: 700;
            font-style: italic;
        }

        .menu {
            display: flex;
            gap: 36px;
            align-items: center;
        }

        .menu a {
            text-decoration: none;
            color: #111827;
            font-size: 16px;
        }

        .menu a:hover {
            color: #ef2b67;
        }

        .search-box {
            margin-left: auto;
            width: 370px;
            height: 50px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            display: flex;
            align-items: center;
            padding: 0 15px;
        }

        .search-box input {
            border: none;
            outline: none;
            width: 100%;
            margin-left: 10px;
            font-size: 16px;
        }

        .header-icons {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 27px;
        }

        .header-icons a {
            color: #111;
            text-decoration: none;
        }

        /* LOGIN */
        .dangnhap-wrapper {
            min-height: calc(100vh - 82px);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 105px 20px 60px;
        }

        .dangnhap-box {
            width: 100%;
            max-width: 650px;
            background: #fff;
            border: 1px solid #eeeeee;
            border-radius: 15px;
            padding: 48px 42px 38px;
            box-shadow: 0 2px 7px rgba(0,0,0,0.03);
        }

        .dangnhap-title {
            text-align: center;
            margin-bottom: 36px;
        }

        .dangnhap-title h1 {
            font-size: 40px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .dangnhap-title p {
            font-size: 18px;
            color: #6b7280;
            margin: 0;
        }

        .form-label {
            font-size: 17px;
            font-weight: 500;
            margin-bottom: 9px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 22px;
        }

        .input-group-custom .icon-left {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            font-size: 18px;
            z-index: 2;
        }

        .input-group-custom input {
            width: 100%;
            height: 60px;
            border: 1px solid #d9dce1;
            border-radius: 10px;
            padding: 0 52px 0 52px;
            font-size: 16px;
            outline: none;
            transition: 0.2s;
        }

        .input-group-custom input:focus {
            border-color: #ef2b67;
            box-shadow: 0 0 0 3px rgba(239, 43, 103, 0.08);
        }

        .toggle-password {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            cursor: pointer;
            font-size: 18px;
        }

        .quen-mat-khau {
            text-align: right;
            margin-top: -8px;
            margin-bottom: 28px;
        }

        .quen-mat-khau a {
            color: #ef2b67;
            text-decoration: underline;
        }

        .btn-dangnhap {
            width: 100%;
            height: 62px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #f32769, #f13979);
            color: white;
            font-size: 20px;
            font-weight: 600;
        }

        .btn-dangnhap:hover {
            opacity: 0.92;
        }

        .duong-ngang {
            display: flex;
            align-items: center;
            gap: 18px;
            color: #6b7280;
            margin: 30px 0 22px;
        }

        .duong-ngang::before,
        .duong-ngang::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #ededed;
        }

        .dangky-text {
            text-align: center;
            color: #6b7280;
            font-size: 16px;
        }

        .dangky-text a {
            color: #ef2b67;
            font-weight: 600;
        }

        .alert {
            border-radius: 10px;
        }

        @media (max-width: 992px) {
            .menu,
            .search-box {
                display: none;
            }

            .logo {
                min-width: auto;
            }

            .header-inner {
                justify-content: space-between;
            }
        }
    </style>
</head>

<body>

<header class="header">
    <div class="header-inner">

        <a href="/" class="logo">
            <div class="logo-icon">
                🧁
            </div>

            <div class="logo-text">
                Sweetie
            </div>
        </a>

        <nav class="menu">
            <a href="/">Trang chủ</a>
            <a href="/san-pham">Sản phẩm</a>
            <a href="/danh-muc">Danh mục</a>
            <a href="#">Giới thiệu</a>
            <a href="#">Liên hệ</a>
        </nav>

        <form action="/san-pham" method="GET" class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input
                type="text"
                name="tuKhoa"
                placeholder="Tìm kiếm sản phẩm..."
            >
        </form>

        <div class="header-icons">
            <a href="/dang-nhap">
                <i class="fa-regular fa-user"></i>
            </a>

            <a href="/gio-hang">
                <i class="fa-solid fa-cart-shopping"></i>
            </a>
        </div>

    </div>
</header>


<main class="dangnhap-wrapper">

    <div class="dangnhap-box">

        <div class="dangnhap-title">

            <h1>Đăng nhập</h1>

            <p>
                Chào mừng bạn quay trở lại Sweetie!
            </p>

        </div>


        <% if (typeof thongBao !== "undefined" && thongBao) { %>

            <div class="alert alert-danger">
                <%= thongBao %>
            </div>

        <% } %>


        <form action="/dang-nhap" method="POST">

            <!-- EMAIL -->

            <label class="form-label">
                Email
            </label>

            <div class="input-group-custom">

                <i class="fa-regular fa-envelope icon-left"></i>

                <input
                    type="email"
                    name="email"
                    placeholder="Nhập email của bạn"
                    required
                >

            </div>


            <!-- MẬT KHẨU -->

            <label class="form-label">
                Mật khẩu
            </label>

            <div class="input-group-custom">

                <i class="fa-solid fa-lock icon-left"></i>

                <input
                    type="password"
                    name="matKhau"
                    id="matKhau"
                    placeholder="Nhập mật khẩu"
                    required
                >

                <i
                    class="fa-regular fa-eye-slash toggle-password"
                    id="togglePassword"
                ></i>

            </div>


            <div class="quen-mat-khau">
                <a href="#">
                    Quên mật khẩu?
                </a>
            </div>


            <button
                type="submit"
                class="btn-dangnhap"
            >
                Đăng nhập
            </button>

        </form>


        <div class="duong-ngang">
            hoặc
        </div>


        <div class="dangky-text">

            Chưa có tài khoản?

            <a href="/dang-ky">
                Đăng ký ngay
            </a>

        </div>

    </div>

</main>


<script>
    const togglePassword = document.getElementById("togglePassword");
    const matKhau = document.getElementById("matKhau");

    togglePassword.addEventListener("click", function () {

        if (matKhau.type === "password") {

            matKhau.type = "text";

            togglePassword.classList.remove("fa-eye-slash");
            togglePassword.classList.add("fa-eye");

        } else {

            matKhau.type = "password";

            togglePassword.classList.remove("fa-eye");
            togglePassword.classList.add("fa-eye-slash");

        }

    });
</script>

</body>
</html>