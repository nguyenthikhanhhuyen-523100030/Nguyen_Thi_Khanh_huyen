<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Đặt hàng - Sweetie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #fff;
            color: #111827;
        }

        /* HEADER */

        .header {
            height: 82px;
            background: #fff;
            border-bottom: 1px solid #f3f3f3;
            display: flex;
            align-items: center;
        }

        .header-inner {
            width: 100%;
            max-width: 1400px;
            margin: auto;
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #ef2b67;
            min-width: 220px;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #fff0f5;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 26px;
        }

        .logo-text {
            font-size: 36px;
            font-weight: 700;
            font-style: italic;
        }

        .menu {
            display: flex;
            gap: 36px;
            align-items: center;
        }

        .menu a {
            color: #111827;
            text-decoration: none;
            font-size: 16px;
        }

        .menu a:hover {
            color: #ef2b67;
        }

        .header-icons {
            margin-left: auto;
            display: flex;
            gap: 28px;
            align-items: center;
            font-size: 27px;
        }

        .header-icons a {
            color: #111;
            text-decoration: none;
        }


        /* MAIN */

        .main {
            max-width: 1400px;
            margin: auto;
            padding: 32px 30px 80px;
        }

        .breadcrumb-custom {
            color: #6b7280;
            margin-bottom: 15px;
        }

        .breadcrumb-custom a {
            color: #6b7280;
            text-decoration: none;
        }

        .breadcrumb-custom span {
            margin: 0 8px;
        }

        .breadcrumb-current {
            color: #ef2b67;
        }

        .page-title {
            font-size: 40px;
            font-weight: 800;
            margin-bottom: 28px;
        }

        .checkout-layout {
            display: grid;
            grid-template-columns: 1fr .95fr;
            gap: 30px;
        }

        .box {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 30px;
            background: white;
        }

        .box h2 {
            font-size: 25px;
            font-weight: 750;
            margin-bottom: 28px;
        }

        /* FORM */

        .form-label-custom {
            display: block;
            font-size: 17px;
            margin-bottom: 8px;
        }

        .required {
            color: #ef2b67;
        }

        .form-control-custom {
            width: 100%;
            height: 56px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 0 16px;
            font-size: 16px;
            outline: none;
            margin-bottom: 22px;
        }

        textarea.form-control-custom {
            height: 100px;
            padding-top: 15px;
            resize: none;
        }

        .form-control-custom:focus {
            border-color: #ef2b67;
            box-shadow: 0 0 0 3px rgba(239,43,103,.08);
        }

        .payment-title {
            font-size: 22px;
            font-weight: 750;
            margin-top: 5px;
            margin-bottom: 20px;
        }

        .payment-option {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 16px;
            font-size: 17px;
        }

        .payment-option input {
            width: 21px;
            height: 21px;
            accent-color: #ef2b67;
        }


        /* ORDER */

        .order-item {
            display: grid;
            grid-template-columns: 80px 1fr 70px 110px;
            align-items: center;
            gap: 15px;
            padding: 18px 0;
            border-top: 1px solid #eeeeee;
        }

        .order-image {
            width: 80px;
            height: 76px;
            border-radius: 8px;
            object-fit: cover;
        }

        .order-name {
            font-size: 17px;
            font-weight: 600;
        }

        .order-price {
            color: #ef2b67;
            font-weight: 700;
            margin-top: 5px;
        }

        .order-quantity {
            text-align: center;
        }

        .order-subtotal {
            text-align: right;
            font-weight: 600;
        }

        .total-box {
            background: #fff5f8;
            border-radius: 7px;
            padding: 22px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 15px;
        }

        .total-box span:first-child {
            font-size: 22px;
            font-weight: 750;
        }

        .total-box span:last-child {
            color: #ef2b67;
            font-size: 30px;
            font-weight: 800;
        }

        .btn-order {
            width: 100%;
            height: 64px;
            border: none;
            border-radius: 8px;
            margin-top: 20px;
            background: linear-gradient(
                90deg,
                #f32769,
                #f13979
            );
            color: #fff;
            font-size: 20px;
            font-weight: 700;
        }

        .btn-order:hover {
            opacity: .92;
        }

        @media(max-width: 950px) {

            .menu {
                display: none;
            }

            .checkout-layout {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body>

<header class="header">

    <div class="header-inner">

        <a href="/" class="logo">

            <div class="logo-icon">
                🧁
            </div>

            <div class="logo-text">
                Sweetie
            </div>

        </a>


        <nav class="menu">

            <a href="/">
                Trang chủ
            </a>

            <a href="/san-pham">
                Sản phẩm
            </a>

            <a href="/#gioi-thieu">
                Giới thiệu
            </a>

            <a href="/#lien-he">
                Liên hệ
            </a>

        </nav>


        <div class="header-icons">

            <a href="/dang-nhap">

                <i class="fa-regular fa-user"></i>

            </a>

            <a href="/gio-hang">

                <i class="fa-solid fa-cart-shopping"></i>

            </a>

        </div>

    </div>

</header>


<main class="main">

    <div class="breadcrumb-custom">

        <a href="/">
            Trang chủ
        </a>

        <span>›</span>

        <a href="/gio-hang">
            Giỏ hàng
        </a>

        <span>›</span>

        <span class="breadcrumb-current">
            Đặt hàng
        </span>

    </div>


    <h1 class="page-title">
        Đặt hàng
    </h1>


    <form
        method="POST"
        action="/dat-hang"
    >

        <div class="checkout-layout">


            <!-- THÔNG TIN NHẬN HÀNG -->

            <div class="box">

                <h2>
                    Thông tin nhận hàng
                </h2>


                <label class="form-label-custom">

                    Họ và tên

                    <span class="required">
                        *
                    </span>

                </label>

                <input
                    type="text"
                    name="hoTen"
                    class="form-control-custom"
                    placeholder="Nhập họ và tên"
                    required
                >


                <label class="form-label-custom">

                    Số điện thoại

                    <span class="required">
                        *
                    </span>

                </label>

                <input
                    type="text"
                    name="soDienThoai"
                    class="form-control-custom"
                    placeholder="Nhập số điện thoại"
                    required
                >


                <label class="form-label-custom">

                    Địa chỉ nhận hàng

                    <span class="required">
                        *
                    </span>

                </label>

                <textarea
                    name="diaChi"
                    class="form-control-custom"
                    placeholder="Nhập địa chỉ"
                    required
                ></textarea>


                <label class="form-label-custom">
                    Ghi chú
                </label>

                <textarea
                    name="ghiChu"
                    class="form-control-custom"
                    placeholder="Ghi chú cho đơn hàng (nếu có)"
                ></textarea>


                <div class="payment-title">
                    Phương thức thanh toán
                </div>


                <label class="payment-option">

                    <input
                        type="radio"
                        name="phuongThucThanhToan"
                        value="COD"
                        checked
                    >

                    Thanh toán khi nhận hàng (COD)

                </label>


                <label class="payment-option">

                    <input
                        type="radio"
                        name="phuongThucThanhToan"
                        value="ChuyenKhoan"
                    >

                    Chuyển khoản ngân hàng

                </label>

            </div>


            <!-- ĐƠN HÀNG -->

            <div class="box">

                <h2>
                    Đơn hàng của bạn
                </h2>


                <% chiTiet.forEach(function(item) { %>


                    <div class="order-item">


                        <img
                            src="<%= item.sanPhamId.hinhAnh || 'https://via.placeholder.com/200x150?text=Banh' %>"
                            class="order-image"
                            alt="<%= item.sanPhamId.tenSanPham %>"
                        >


                        <div>

                            <div class="order-name">

                                <%= item.sanPhamId.tenSanPham %>

                            </div>


                            <div class="order-price">

                                <%= item.donGia.toLocaleString("vi-VN") %>đ

                            </div>

                        </div>


                        <div class="order-quantity">

                            x <%= item.soLuong %>

                        </div>


                        <div class="order-subtotal">

                            <%= (item.donGia * item.soLuong).toLocaleString("vi-VN") %>đ

                        </div>

                    </div>


                <% }) %>


                <div class="total-box">

                    <span>
                        Tổng cộng
                    </span>

                    <span>
                        <%= tongTien.toLocaleString("vi-VN") %>đ
                    </span>

                </div>


                <button
                    type="submit"
                    class="btn-order"
                >
                    Đặt hàng
                </button>

            </div>

        </div>

    </form>

</main>

</body>
</html>