<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Đơn hàng của tôi - Sweetie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #fff;
            color: #111827;
        }

        .header {
            height: 82px;
            border-bottom: 1px solid #f3f3f3;
            display: flex;
            align-items: center;
            background: #fff;
        }

        .header-inner {
            width: 100%;
            max-width: 1400px;
            margin: auto;
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #ef2b67;
            min-width: 220px;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #fff0f5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .logo-text {
            font-size: 36px;
            font-weight: 700;
            font-style: italic;
        }

        .menu {
            display: flex;
            gap: 36px;
            align-items: center;
        }

        .menu a {
            text-decoration: none;
            color: #111827;
            font-size: 16px;
        }

        .menu a:hover {
            color: #ef2b67;
        }

        .header-icons {
            margin-left: auto;
            display: flex;
            gap: 28px;
            align-items: center;
            font-size: 27px;
        }

        .header-icons a {
            color: #111;
            text-decoration: none;
        }

        .main {
            max-width: 1400px;
            margin: auto;
            padding: 45px 30px 80px;
        }

        .breadcrumb-custom {
            color: #6b7280;
            margin-bottom: 20px;
        }

        .breadcrumb-custom a {
            color: #6b7280;
            text-decoration: none;
        }

        .breadcrumb-custom span {
            margin: 0 8px;
        }

        .page-title {
            font-size: 40px;
            font-weight: 800;
            margin-bottom: 30px;
        }

        .order-card {
            border: 1px solid #eeeeee;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 20px;
            background: #fff;
            box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        }

        .order-top {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            align-items: center;
            margin-bottom: 15px;
        }

        .order-code {
            font-size: 18px;
            font-weight: 700;
        }

        .order-date {
            color: #6b7280;
            font-size: 15px;
            margin-top: 4px;
        }

        .order-status {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        .status-cho {
            background: #fff7d6;
            color: #9a6700;
        }

        .status-xuly {
            background: #e0f2fe;
            color: #0369a1;
        }

        .status-giao {
            background: #ede9fe;
            color: #6d28d9;
        }

        .status-hoanthanh {
            background: #dcfce7;
            color: #15803d;
        }

        .status-huy {
            background: #fee2e2;
            color: #b91c1c;
        }

        .order-body {
            border-top: 1px solid #f0f0f0;
            padding-top: 16px;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 20px;
            align-items: end;
        }

        .order-info p {
            margin: 5px 0;
            color: #4b5563;
        }

        .order-total {
            text-align: right;
        }

        .order-total-label {
            color: #6b7280;
            font-size: 14px;
        }

        .order-total-price {
            color: #ef2b67;
            font-size: 24px;
            font-weight: 800;
        }

        .btn-detail {
            display: inline-block;
            margin-top: 12px;
            padding: 10px 18px;
            border-radius: 8px;
            border: 1px solid #ef2b67;
            color: #ef2b67;
            text-decoration: none;
            font-weight: 600;
        }

        .btn-detail:hover {
            background: #ef2b67;
            color: white;
        }

        .empty-order {
            text-align: center;
            padding: 70px 20px;
            background: #fff7fa;
            border-radius: 14px;
            border: 1px solid #ffe1eb;
        }

        .empty-order i {
            font-size: 58px;
            color: #ef2b67;
            margin-bottom: 18px;
        }

        .empty-order p {
            color: #6b7280;
        }

        .btn-shop {
            display: inline-block;
            margin-top: 12px;
            padding: 12px 22px;
            border-radius: 8px;
            background: #ef2b67;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }

        @media (max-width: 900px) {
            .menu {
                display: none;
            }

            .header-inner {
                justify-content: space-between;
            }

            .logo {
                min-width: auto;
            }

            .order-body {
                grid-template-columns: 1fr;
            }

            .order-total {
                text-align: left;
            }
        }
    </style>
</head>

<body>

<header class="header">
    <div class="header-inner">

        <a href="/" class="logo">
            <div class="logo-icon">🧁</div>
            <div class="logo-text">Sweetie</div>
        </a>

        <nav class="menu">
            <a href="/">Trang chủ</a>
            <a href="/san-pham">Sản phẩm</a>
            <a href="/danh-muc">Danh mục</a>
            <a href="/#gioi-thieu">Giới thiệu</a>
            <a href="/#lien-he">Liên hệ</a>
        </nav>

        <div class="header-icons">
            <a href="/dang-nhap">
                <i class="fa-regular fa-user"></i>
            </a>

            <a href="/gio-hang">
                <i class="fa-solid fa-cart-shopping"></i>
            </a>
        </div>

    </div>
</header>

<main class="main">

    <div class="breadcrumb-custom">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <strong>Đơn hàng</strong>
    </div>

    <h1 class="page-title">
        Đơn hàng của tôi
    </h1>

    <% if (!donHangs || donHangs.length === 0) { %>

        <div class="empty-order">
            <i class="fa-solid fa-box-open"></i>

            <h3>Chưa có đơn hàng</h3>

            <p>
                Bạn chưa đặt đơn hàng nào tại Sweetie.
            </p>

            <a href="/san-pham" class="btn-shop">
                Mua sắm ngay
            </a>
        </div>

    <% } else { %>

        <% donHangs.forEach(function(dh) { %>

            <div class="order-card">

                <div class="order-top">

                    <div>
                        <div class="order-code">
                            Mã đơn: <%= dh._id %>
                        </div>

                        <div class="order-date">
                            Ngày đặt:
                            <%= new Date(dh.ngayDat || dh.createdAt).toLocaleString("vi-VN") %>
                        </div>
                    </div>

                    <div>
                        <% let statusClass = "status-cho"; %>

                        <% if (dh.trangThai === "Đang xử lý") statusClass = "status-xuly"; %>
                        <% if (dh.trangThai === "Đang giao") statusClass = "status-giao"; %>
                        <% if (dh.trangThai === "Hoàn thành") statusClass = "status-hoanthanh"; %>
                        <% if (dh.trangThai === "Đã hủy") statusClass = "status-huy"; %>

                        <span class="order-status <%= statusClass %>">
                            <%= dh.trangThai %>
                        </span>
                    </div>

                </div>

                <div class="order-body">

                    <div class="order-info">
                        <p>
                            <strong>Người nhận:</strong>
                            <%= dh.hoTen %>
                        </p>

                        <p>
                            <strong>Số điện thoại:</strong>
                            <%= dh.soDienThoai %>
                        </p>

                        <p>
                            <strong>Địa chỉ:</strong>
                            <%= dh.diaChi %>
                        </p>

                        <p>
                            <strong>Thanh toán:</strong>
                            <%= dh.phuongThucThanhToan === "COD"
                                ? "Thanh toán khi nhận hàng"
                                : "Chuyển khoản ngân hàng"
                            %>
                        </p>
                    </div>

                    <div class="order-total">

                        <div class="order-total-label">
                            Tổng tiền
                        </div>

                        <div class="order-total-price">
                            <%= dh.tongTien.toLocaleString("vi-VN") %>đ
                        </div>

                        <a
                            href="/don-hang/<%= dh._id %>"
                            class="btn-detail"
                        >
                            Xem chi tiết
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    <% } %>

</main>

</body>
</html>