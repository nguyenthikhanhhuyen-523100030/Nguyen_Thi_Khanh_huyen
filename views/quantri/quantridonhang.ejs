<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Quản lý đơn hàng - Sweetie Admin</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f8f9fb;
            color: #111827;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 280px;
            background: #1f2631;
            color: white;
            padding: 25px 14px;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px 35px;
        }

        .logo-icon {
            font-size: 32px;
            color: #ff759b;
        }

        .logo-name {
            font-size: 30px;
            font-weight: 700;
            font-style: italic;
            color: #ff759b;
        }

        .logo-admin {
            font-size: 18px;
        }

        .menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .menu-item {
            margin-bottom: 8px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 17px 18px;
            color: #e5e7eb;
            text-decoration: none;
            border-radius: 8px;
            font-size: 17px;
        }

        .menu-link i {
            width: 28px;
            text-align: center;
            font-size: 21px;
        }

        .menu-link:hover,
        .menu-link.active {
            background: linear-gradient(90deg, #9d3767, #9f426d);
            color: white;
        }

        .sidebar-line {
            border-top: 1px solid #4b5563;
            margin: 25px 10px;
        }

        /* MAIN */
        .main {
            margin-left: 280px;
            width: calc(100% - 280px);
        }

        .topbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #eee;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 32px;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 17px;
        }

        .admin-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .content {
            padding: 32px 35px 60px;
        }

        .page-title {
            font-size: 38px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: #6b7280;
            font-size: 18px;
            margin-bottom: 28px;
        }

        /* FILTER */
        .filter-form {
            display: grid;
            grid-template-columns: 1fr 230px 150px;
            gap: 15px;
            margin-bottom: 22px;
        }

        .search-box {
            height: 52px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            display: flex;
            align-items: center;
            padding: 0 16px;
        }

        .search-box input {
            flex: 1;
            border: none;
            outline: none;
            margin-left: 12px;
            font-size: 16px;
        }

        .filter-select {
            height: 52px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 0 14px;
            background: white;
        }

        .btn-search {
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #f32769, #f13979);
            color: white;
            font-weight: 600;
            font-size: 16px;
        }

        /* TABLE */
        .table-box {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: #fafafa;
            color: #374151;
            border: none;
            padding: 16px;
            font-weight: 700;
        }

        .table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-color: #eee;
        }

        .customer-phone {
            color: #6b7280;
            font-size: 14px;
            margin-top: 3px;
        }

        .status {
            display: inline-block;
            padding: 7px 13px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .status-cho {
            background: #fff3da;
            color: #d97706;
        }

        .status-xuly {
            background: #e0f2fe;
            color: #0369a1;
        }

        .status-giao {
            background: #ede9fe;
            color: #6d28d9;
        }

        .status-hoanthanh {
            background: #dcfce7;
            color: #15803d;
        }

        .status-huy {
            background: #fee2e2;
            color: #b91c1c;
        }

        .action-link {
            color: #6b7280;
            text-decoration: none;
            font-size: 19px;
            margin-right: 18px;
        }

        .action-link:hover {
            color: #ef2b67;
        }

        .bottom-info {
            margin-top: 18px;
            color: #6b7280;
        }

        @media(max-width: 1000px) {
            .sidebar {
                width: 220px;
            }

            .main {
                margin-left: 220px;
                width: calc(100% - 220px);
            }

            .filter-form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="admin-layout">

    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">🧁</div>
            <div class="logo-name">Sweetie</div>
            <div class="logo-admin">Admin</div>
        </div>

        <ul class="menu">

            <li class="menu-item">
                <a href="/quan-tri" class="menu-link">
                    <i class="fa-solid fa-house"></i>
                    Tổng quan
                </a>
            </li>

            <li class="menu-item">
                <a href="/quan-tri/san-pham" class="menu-link">
                    <i class="fa-solid fa-cube"></i>
                    Quản lý sản phẩm
                </a>
            </li>

            <li class="menu-item">
                <a href="/quan-tri/danh-muc" class="menu-link">
                    <i class="fa-solid fa-layer-group"></i>
                    Quản lý danh mục
                </a>
            </li>

            <li class="menu-item">
                <a href="/quan-tri/don-hang" class="menu-link active">
                    <i class="fa-solid fa-clipboard-list"></i>
                    Quản lý đơn hàng
                </a>
            </li>

        </ul>

        <div class="sidebar-line"></div>

        <ul class="menu">
            <li class="menu-item">
                <a href="/dang-xuat" class="menu-link">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Đăng xuất
                </a>
            </li>
        </ul>

    </aside>


    <div class="main">

        <div class="topbar">

            <div class="admin-user">

                <div class="admin-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>

                <span>
                    <%= typeof nguoiDung !== "undefined" && nguoiDung
                        ? nguoiDung.hoTen
                        : "Admin"
                    %>
                </span>

                <i class="fa-solid fa-chevron-down"></i>

            </div>

        </div>


        <div class="content">

            <h1 class="page-title">
                Quản lý đơn hàng
            </h1>

            <div class="page-subtitle">
                Xem, cập nhật trạng thái và quản lý các đơn hàng của khách.
            </div>


            <form
                action="/quan-tri/don-hang"
                method="GET"
                class="filter-form"
            >

                <div class="search-box">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input
                        type="text"
                        name="tuKhoa"
                        value="<%= typeof tuKhoa !== 'undefined' ? tuKhoa : '' %>"
                        placeholder="Tìm tên khách hàng..."
                    >

                </div>


                <select
                    name="trangThai"
                    class="filter-select"
                >

                    <option value="">
                        Tất cả trạng thái
                    </option>

                    <option
                        value="Chờ xác nhận"
                        <%= trangThai === "Chờ xác nhận" ? "selected" : "" %>
                    >
                        Chờ xác nhận
                    </option>

                    <option
                        value="Đang xử lý"
                        <%= trangThai === "Đang xử lý" ? "selected" : "" %>
                    >
                        Đang xử lý
                    </option>

                    <option
                        value="Đang giao"
                        <%= trangThai === "Đang giao" ? "selected" : "" %>
                    >
                        Đang giao
                    </option>

                    <option
                        value="Hoàn thành"
                        <%= trangThai === "Hoàn thành" ? "selected" : "" %>
                    >
                        Hoàn thành
                    </option>

                    <option
                        value="Đã hủy"
                        <%= trangThai === "Đã hủy" ? "selected" : "" %>
                    >
                        Đã hủy
                    </option>

                </select>


                <button
                    type="submit"
                    class="btn-search"
                >
                    <i class="fa-solid fa-magnifying-glass me-2"></i>
                    Tìm kiếm
                </button>

            </form>


            <div class="table-box">

                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã đơn hàng</th>
                                <th>Ngày đặt</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>

                        <% if (donHangs && donHangs.length > 0) { %>

                            <% donHangs.forEach(function(dh, index) { %>

                                <tr>

                                    <td>
                                        <%= index + 1 %>
                                    </td>

                                    <td>
                                        #
                                        <%= dh._id
                                            .toString()
                                            .slice(-6)
                                            .toUpperCase()
                                        %>
                                    </td>

                                    <td>
                                        <%= new Date(
                                            dh.ngayDat || dh.createdAt
                                        ).toLocaleString("vi-VN") %>
                                    </td>

                                    <td>

                                        <div>
                                            <%= dh.hoTen %>
                                        </div>

                                        <div class="customer-phone">
                                            <%= dh.soDienThoai %>
                                        </div>

                                    </td>

                                    <td>
                                        <%= dh.tongTien.toLocaleString("vi-VN") %>đ
                                    </td>

                                    <td>

                                        <% let lop = "status-cho"; %>

                                        <% if (dh.trangThai === "Đang xử lý") lop = "status-xuly"; %>
                                        <% if (dh.trangThai === "Đang giao") lop = "status-giao"; %>
                                        <% if (dh.trangThai === "Hoàn thành") lop = "status-hoanthanh"; %>
                                        <% if (dh.trangThai === "Đã hủy") lop = "status-huy"; %>

                                        <span class="status <%= lop %>">
                                            <%= dh.trangThai %>
                                        </span>

                                    </td>

                                    <td>

                                        <a
                                            href="/quan-tri/don-hang/<%= dh._id %>"
                                            class="action-link"
                                            title="Xem chi tiết"
                                        >
                                            <i class="fa-regular fa-eye"></i>
                                        </a>

                                        <a
                                            href="/quan-tri/don-hang/sua/<%= dh._id %>"
                                            class="action-link"
                                            title="Cập nhật trạng thái"
                                        >
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>
                                <td
                                    colspan="7"
                                    class="text-center py-4"
                                >
                                    Không tìm thấy đơn hàng.
                                </td>
                            </tr>

                        <% } %>

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="bottom-info">

                Hiển thị
                <%= donHangs ? donHangs.length : 0 %>
                đơn hàng

            </div>

        </div>

    </div>

</div>

</body>
</html>