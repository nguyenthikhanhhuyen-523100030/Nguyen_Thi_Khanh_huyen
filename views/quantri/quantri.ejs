<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Quản trị - Sweetie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f8f9fb;
            color: #111827;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 280px;
            background: #1f2631;
            color: white;
            padding: 25px 14px;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px 35px;
        }

        .logo-icon {
            font-size: 33px;
            color: #ff759b;
        }

        .logo-name {
            font-size: 30px;
            font-weight: 700;
            font-style: italic;
            color: #ff759b;
        }

        .logo-admin {
            font-size: 18px;
            margin-left: 3px;
        }

        .menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .menu-item {
            margin-bottom: 8px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 17px 18px;
            color: #e5e7eb;
            text-decoration: none;
            border-radius: 8px;
            font-size: 17px;
        }

        .menu-link i {
            width: 28px;
            text-align: center;
            font-size: 21px;
        }

        .menu-link:hover,
        .menu-link.active {
            background: linear-gradient(
                90deg,
                #9d3767,
                #9f426d
            );
            color: white;
        }

        .sidebar-line {
            border-top: 1px solid #4b5563;
            margin: 25px 10px;
        }

        /* CONTENT */

        .main {
            margin-left: 280px;
            width: calc(100% - 280px);
        }

        .topbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #eeeeee;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 32px;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 17px;
        }

        .admin-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .content {
            padding: 38px 35px;
        }

        .page-title {
            font-size: 38px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #6b7280;
            font-size: 18px;
            margin-bottom: 30px;
        }

        /* STATS */

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
            margin-bottom: 30px;
        }

        .stat-card {
            min-height: 150px;
            border-radius: 14px;
            padding: 25px;
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .stat-card.blue {
            background: #edf6ff;
        }

        .stat-card.green {
            background: #effcf4;
        }

        .stat-card.orange {
            background: #fff9eb;
        }

        .stat-icon {
            width: 92px;
            height: 92px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
        }

        .blue .stat-icon {
            background: #d9ecff;
            color: #1683ff;
        }

        .green .stat-icon {
            background: #dcf6e5;
            color: #19a44a;
        }

        .orange .stat-icon {
            background: #fff0cd;
            color: #ff8a00;
        }

        .stat-label {
            font-size: 20px;
            margin-bottom: 4px;
        }

        .stat-number {
            font-size: 38px;
            font-weight: 800;
        }

        .blue .stat-number {
            color: #1677ee;
        }

        .green .stat-number {
            color: #169846;
        }

        .orange .stat-number {
            color: #ff7a00;
        }

        /* ORDERS */

        .order-box {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 24px;
        }

        .order-box-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .order-box h2 {
            font-size: 27px;
            font-weight: 800;
            margin: 0;
        }

        .view-all {
            background: #fff1f5;
            color: #ef2b67;
            text-decoration: none;
            padding: 11px 17px;
            border-radius: 7px;
            font-weight: 600;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: #fafafa;
            color: #4b5563;
            border: none;
            padding: 16px;
            font-weight: 700;
        }

        .table tbody td {
            padding: 17px 16px;
            vertical-align: middle;
            border-color: #eeeeee;
        }

        .status {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .status-cho {
            background: #fff3da;
            color: #d97706;
        }

        .status-xuly {
            background: #e0f2fe;
            color: #0369a1;
        }

        .status-giao {
            background: #ede9fe;
            color: #6d28d9;
        }

        .status-hoanthanh {
            background: #dcfce7;
            color: #15803d;
        }

        .status-huy {
            background: #fee2e2;
            color: #b91c1c;
        }

        .action-link {
            color: #1677ee;
            text-decoration: none;
            font-weight: 600;
        }

        @media (max-width: 1000px) {
            .sidebar {
                width: 220px;
            }

            .main {
                margin-left: 220px;
                width: calc(100% - 220px);
            }

            .stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">
                🧁
            </div>

            <div class="logo-name">
                Sweetie
            </div>

            <div class="logo-admin">
                Admin
            </div>
        </div>

        <ul class="menu">

            <li class="menu-item">
                <a href="/quan-tri" class="menu-link active">
                    <i class="fa-solid fa-house"></i>
                    Tổng quan
                </a>
            </li>

            <li class="menu-item">
                <a href="/quan-tri/san-pham" class="menu-link">
                    <i class="fa-solid fa-cube"></i>
                    Quản lý sản phẩm
                </a>
            </li>

            <li class="menu-item">
                <a href="/quan-tri/danh-muc" class="menu-link">
                    <i class="fa-solid fa-layer-group"></i>
                    Quản lý danh mục
                </a>
            </li>

            <li class="menu-item">
                <a href="/quan-tri/don-hang" class="menu-link">
                    <i class="fa-solid fa-clipboard-list"></i>
                    Quản lý đơn hàng
                </a>
            </li>

        </ul>

        <div class="sidebar-line"></div>

        <ul class="menu">
            <li class="menu-item">
                <a href="/dang-xuat" class="menu-link">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Đăng xuất
                </a>
            </li>
        </ul>

    </aside>


    <!-- MAIN -->
    <div class="main">

        <div class="topbar">

            <div class="admin-user">

                <div class="admin-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>

                <span>
                    <%= typeof nguoiDung !== "undefined" && nguoiDung
                        ? nguoiDung.hoTen
                        : "Admin"
                    %>
                </span>

                <i class="fa-solid fa-chevron-down"></i>

            </div>

        </div>


        <div class="content">

            <h1 class="page-title">
                Tổng quan
            </h1>

            <div class="page-subtitle">
                Chào mừng bạn quay trở lại!
            </div>


            <!-- STATISTICS -->

            <div class="stats">

                <div class="stat-card blue">

                    <div class="stat-icon">
                        <i class="fa-solid fa-cake-candles"></i>
                    </div>

                    <div>
                        <div class="stat-label">
                            Sản phẩm
                        </div>

                        <div class="stat-number">
                            <%= soSanPham %>
                        </div>
                    </div>

                </div>


                <div class="stat-card green">

                    <div class="stat-icon">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>

                    <div>
                        <div class="stat-label">
                            Đơn hàng
                        </div>

                        <div class="stat-number">
                            <%= soDonHang %>
                        </div>
                    </div>

                </div>


                <div class="stat-card orange">

                    <div class="stat-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div>
                        <div class="stat-label">
                            Khách hàng
                        </div>

                        <div class="stat-number">
                            <%= soKhachHang %>
                        </div>
                    </div>

                </div>

            </div>


            <!-- RECENT ORDERS -->

            <div class="order-box">

                <div class="order-box-top">

                    <h2>
                        Đơn hàng gần đây
                    </h2>

                    <a
                        href="/quan-tri/don-hang"
                        class="view-all"
                    >
                        Xem tất cả →
                    </a>

                </div>


                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (donHangGanDay && donHangGanDay.length > 0) { %>

                                <% donHangGanDay.forEach(function(dh) { %>

                                    <tr>

                                        <td>
                                            #
                                            <%= dh._id
                                                .toString()
                                                .slice(-6)
                                                .toUpperCase()
                                            %>
                                        </td>

                                        <td>
                                            <%= new Date(
                                                dh.ngayDat || dh.createdAt
                                            ).toLocaleDateString("vi-VN") %>
                                        </td>

                                        <td>
                                            <%= dh.hoTen %>
                                        </td>

                                        <td>
                                            <%= dh.tongTien.toLocaleString("vi-VN") %>đ
                                        </td>

                                        <td>

                                            <% let lop = "status-cho"; %>

                                            <% if (dh.trangThai === "Đang xử lý")
                                                lop = "status-xuly"; %>

                                            <% if (dh.trangThai === "Đang giao")
                                                lop = "status-giao"; %>

                                            <% if (dh.trangThai === "Hoàn thành")
                                                lop = "status-hoanthanh"; %>

                                            <% if (dh.trangThai === "Đã hủy")
                                                lop = "status-huy"; %>

                                            <span class="status <%= lop %>">
                                                <%= dh.trangThai %>
                                            </span>

                                        </td>

                                        <td>

                                            <a
                                                href="/quan-tri/don-hang/<%= dh._id %>"
                                                class="action-link"
                                            >
                                                Xem
                                            </a>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td
                                        colspan="6"
                                        class="text-center py-4"
                                    >
                                        Chưa có đơn hàng.
                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>