<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Quản lý danh mục - Sweetie Admin
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f8f9fb;
            color: #111827;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 280px;
            background: #1f2631;
            color: white;
            padding: 25px 14px;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px 35px;
        }

        .logo-icon {
            font-size: 32px;
        }

        .logo-name {
            font-size: 30px;
            font-weight: 700;
            font-style: italic;
            color: #ff759b;
        }

        .logo-admin {
            font-size: 18px;
        }

        .menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .menu-item {
            margin-bottom: 8px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 17px 18px;
            color: #e5e7eb;
            text-decoration: none;
            border-radius: 8px;
            font-size: 17px;
        }

        .menu-link i {
            width: 28px;
            text-align: center;
            font-size: 21px;
        }

        .menu-link:hover,
        .menu-link.active {

            background:
                linear-gradient(
                    90deg,
                    #9d3767,
                    #9f426d
                );

            color: white;
        }

        .sidebar-line {
            border-top: 1px solid #4b5563;
            margin: 25px 10px;
        }


        /* MAIN */

        .main {

            margin-left: 280px;

            width:
                calc(100% - 280px);

        }

        .topbar {

            height: 70px;

            background: white;

            border-bottom:
                1px solid #eee;

            display: flex;

            justify-content:
                flex-end;

            align-items: center;

            padding: 0 32px;

        }

        .admin-user {

            display: flex;

            align-items: center;

            gap: 12px;

        }

        .admin-avatar {

            width: 42px;

            height: 42px;

            border-radius: 50%;

            background: #e5e7eb;

            display: flex;

            align-items: center;

            justify-content: center;

        }

        .content {

            padding:
                32px 35px 60px;

        }

        .page-title {

            font-size: 38px;

            font-weight: 800;

            margin-bottom: 4px;

        }

        .page-subtitle {

            color: #6b7280;

            font-size: 18px;

            margin-bottom: 30px;

        }


        /* GRID */

        .category-layout {

            display: grid;

            grid-template-columns:
                380px 1fr;

            gap: 25px;

        }


        /* FORM */

        .form-box {

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius: 12px;

            padding: 25px;

            height: fit-content;

        }

        .form-box h2 {

            font-size: 23px;

            font-weight: 750;

            margin-bottom: 22px;

        }

        .form-label {

            font-weight: 600;

        }

        .form-control {

            border-radius: 8px;

        }

        textarea.form-control {

            height: 100px;

            resize: none;

        }

        .btn-add {

            width: 100%;

            height: 50px;

            border: none;

            border-radius: 8px;

            background:
                linear-gradient(
                    90deg,
                    #f32769,
                    #f13979
                );

            color: white;

            font-weight: 600;

        }


        /* TABLE */

        .table-box {

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius: 12px;

            overflow: hidden;

        }

        .table {

            margin-bottom: 0;

        }

        .table thead th {

            background: #fafafa;

            border: none;

            padding: 16px;

        }

        .table tbody td {

            padding: 15px 16px;

            vertical-align: middle;

        }

        .category-image {

            width: 80px;

            height: 60px;

            border-radius: 7px;

            object-fit: cover;

        }

        .status {

            padding: 7px 13px;

            border-radius: 8px;

            font-size: 14px;

            font-weight: 600;

        }

        .status-on {

            background: #dcfce7;

            color: #15803d;

        }

        .status-off {

            background: #fee2e2;

            color: #b91c1c;

        }

        .action {

            text-decoration: none;

            border: none;

            background: transparent;

            font-size: 18px;

            margin-right: 12px;

        }

        .edit {

            color: #6b7280;

        }

        .delete {

            color: #ef4444;

        }

        @media(max-width: 1050px) {

            .category-layout {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>
<script>
function xemTruocAnh(event) {
    const file = event.target.files[0];
    const preview = document.getElementById("previewImage");

    if (!file) {
        preview.style.display = "none";
        preview.src = "";
        return;
    }

    preview.src = URL.createObjectURL(file);
    preview.style.display = "block";
}
</script>

<body>

<div class="admin-layout">


    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                🧁
            </div>

            <div class="logo-name">
                Sweetie
            </div>

            <div class="logo-admin">
                Admin
            </div>

        </div>


        <ul class="menu">

            <li class="menu-item">

                <a
                    href="/quan-tri"
                    class="menu-link"
                >

                    <i class="fa-solid fa-house"></i>

                    Tổng quan

                </a>

            </li>


            <li class="menu-item">

                <a
                    href="/quan-tri/san-pham"
                    class="menu-link"
                >

                    <i class="fa-solid fa-cube"></i>

                    Quản lý sản phẩm

                </a>

            </li>


            <li class="menu-item">

                <a
                    href="/quan-tri/danh-muc"
                    class="menu-link active"
                >

                    <i class="fa-solid fa-layer-group"></i>

                    Quản lý danh mục

                </a>

            </li>


            <li class="menu-item">

                <a
                    href="/quan-tri/don-hang"
                    class="menu-link"
                >

                    <i class="fa-solid fa-clipboard-list"></i>

                    Quản lý đơn hàng

                </a>

            </li>

        </ul>


        <div class="sidebar-line"></div>


        <ul class="menu">

            <li class="menu-item">

                <a
                    href="/dang-xuat"
                    class="menu-link"
                >

                    <i class="fa-solid fa-right-from-bracket"></i>

                    Đăng xuất

                </a>

            </li>

        </ul>

    </aside>


    <!-- MAIN -->

    <div class="main">


        <div class="topbar">

            <div class="admin-user">

                <div class="admin-avatar">

                    <i class="fa-solid fa-user"></i>

                </div>

                <span>

                    <%= nguoiDung
                        ? nguoiDung.hoTen
                        : "Admin"
                    %>

                </span>

            </div>

        </div>


        <div class="content">


            <h1 class="page-title">
                Quản lý danh mục
            </h1>


            <div class="page-subtitle">

                Thêm, sửa và quản lý
                các loại bánh trong cửa hàng.

            </div>


            <div class="category-layout">


                <!-- THÊM DANH MỤC -->

                <div class="form-box">

                    <h2>
                        Thêm danh mục
                    </h2>


                    <form
    action="/quan-tri/danh-muc/them"
    method="POST"
    enctype="multipart/form-data"
    onsubmit="console.log('FORM ĐANG SUBMIT');"
>

                        <div class="mb-3">

                            <label class="form-label">
                                Tên danh mục
                            </label>

                            <input
                                type="text"
                                name="tenDanhMuc"
                                class="form-control"
                                placeholder="Ví dụ: Bánh kem"
                                required
                            >

                        </div>


 <div class="mb-3">
    <label class="form-label">Hình ảnh danh mục</label>

  <input
    type="file"
    name="hinhAnh"
    class="form-control"
    accept=".jpg,.jpeg,.png,.webp"
    onchange="xemTruocAnh(event)"
>

    <div class="mt-3">
        <img
            id="previewImage"
            style="
                display: none;
                width: 100%;
                height: 180px;
                object-fit: cover;
                border-radius: 10px;
            "
        >
    </div>
</div>


                        <div class="mb-4">

                            <label class="form-label">
                                Mô tả
                            </label>

                            <textarea
                                name="moTa"
                                class="form-control"
                                placeholder="Nhập mô tả"
                            ></textarea>

                        </div>


                        <button
    type="submit"
    class="btn-add"
>
    <i class="fa-solid fa-plus me-2"></i>
    Thêm danh mục
</button>

                    </form>

                </div>


                <!-- DANH SÁCH -->

                <div class="table-box">

                    <div class="table-responsive">

                        <table class="table">

                            <thead>

                                <tr>

                                    <th>STT</th>

                                    <th>Hình ảnh</th>

                                    <th>Tên danh mục</th>

                                    <th>Mô tả</th>

                                    <th>Trạng thái</th>

                                    <th>Thao tác</th>

                                </tr>

                            </thead>


                            <tbody>


                            <% if (
                                danhMucs &&
                                danhMucs.length > 0
                            ) { %>


                                <% danhMucs.forEach(
                                    function(dm, index) {
                                %>


                                    <tr>


                                        <td>

                                            <%= index + 1 %>

                                        </td>


                                        <td>

                                            <img
                                                src="<%= dm.hinhAnh || 'https://via.placeholder.com/100x70?text=Danh+muc' %>"
                                                class="category-image"
                                            >

                                        </td>


                                        <td>

                                            <strong>
                                                <%= dm.tenDanhMuc %>
                                            </strong>

                                        </td>


                                        <td>

                                            <%= dm.moTa || "" %>

                                        </td>


                                        <td>


                                            <% if (
                                                dm.trangThai
                                            ) { %>

                                                <span
                                                    class="status status-on"
                                                >
                                                    Hoạt động
                                                </span>

                                            <% } else { %>

                                                <span
                                                    class="status status-off"
                                                >
                                                    Ngừng hoạt động
                                                </span>

                                            <% } %>


                                        </td>


                                        <td>


                                            <a
                                                href="/quan-tri/danh-muc/sua/<%= dm._id %>"
                                                class="action edit"
                                            >

                                                <i class="fa-solid fa-pen"></i>

                                            </a>


                                            <form
                                                action="/quan-tri/danh-muc/xoa/<%= dm._id %>"
                                                method="POST"
                                                style="display:inline;"
                                                onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?')"
                                            >

                                                <button
                                                    class="action delete"
                                                    type="submit"
                                                >

                                                    <i class="fa-solid fa-trash-can"></i>

                                                </button>

                                            </form>


                                        </td>


                                    </tr>


                                <% }) %>


                            <% } else { %>


                                <tr>

                                    <td
                                        colspan="6"
                                        class="text-center py-4"
                                    >

                                        Chưa có danh mục.

                                    </td>

                                </tr>


                            <% } %>


                            </tbody>

                        </table>

                    </div>

                </div>


            </div>

        </div>

    </div>

</div>

</body>

</html>