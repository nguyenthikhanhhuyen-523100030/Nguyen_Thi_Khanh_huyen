<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sửa danh mục - Sweetie Admin</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f8f9fb;
            color: #111827;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 280px;
            background: #1f2631;
            color: white;
            padding: 25px 14px;

            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 0 16px 35px;
        }

        .logo-icon {
            font-size: 32px;
        }

        .logo-name {
            font-size: 30px;
            font-weight: 700;
            font-style: italic;
            color: #ff759b;
        }

        .logo-admin {
            font-size: 18px;
        }

        .menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .menu-item {
            margin-bottom: 8px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 16px;

            padding: 17px 18px;

            color: #e5e7eb;
            text-decoration: none;

            border-radius: 8px;
            font-size: 17px;
        }

        .menu-link i {
            width: 28px;
            text-align: center;
            font-size: 21px;
        }

        .menu-link:hover,
        .menu-link.active {
            background: linear-gradient(
                90deg,
                #9d3767,
                #9f426d
            );

            color: white;
        }

        .sidebar-line {
            border-top: 1px solid #4b5563;
            margin: 25px 10px;
        }

        /* MAIN */
        .main {
            margin-left: 280px;
            width: calc(100% - 280px);
        }

        .topbar {
            height: 70px;

            background: white;
            border-bottom: 1px solid #eee;

            display: flex;
            justify-content: flex-end;
            align-items: center;

            padding: 0 32px;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-avatar {
            width: 42px;
            height: 42px;

            border-radius: 50%;
            background: #e5e7eb;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .content {
            padding: 32px 35px 60px;
        }

        .page-title {
            font-size: 38px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: #6b7280;
            font-size: 18px;
            margin-bottom: 30px;
        }

        /* FORM */
        .form-box {
            max-width: 750px;

            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 14px;

            padding: 30px;

            box-shadow: 0 8px 25px rgba(0,0,0,0.04);
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            border-radius: 8px;
            min-height: 48px;
        }

        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        .current-image {
            width: 220px;
            height: 150px;

            object-fit: cover;

            border-radius: 12px;
            border: 1px solid #e5e7eb;
        }

        .image-title {
            font-size: 13px;
            color: #6b7280;
            margin: 8px 0;
        }

        .button-group {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }

        .btn-save {
            border: none;
            border-radius: 8px;

            padding: 13px 25px;

            background: linear-gradient(
                90deg,
                #f32769,
                #f13979
            );

            color: white;
            font-weight: 600;
        }

        .btn-back {
            border: 1px solid #d1d5db;
            border-radius: 8px;

            padding: 13px 25px;

            background: white;
            color: #374151;

            text-decoration: none;
            font-weight: 600;
        }

        .btn-back:hover {
            background: #f3f4f6;
            color: #111827;
        }
    </style>
</head>

<body>

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">🧁</div>
            <div class="logo-name">Sweetie</div>
            <div class="logo-admin">Admin</div>
        </div>

        <ul class="menu">

            <li class="menu-item">
                <a
                    href="/quan-tri"
                    class="menu-link"
                >
                    <i class="fa-solid fa-house"></i>
                    Tổng quan
                </a>
            </li>

            <li class="menu-item">
                <a
                    href="/quan-tri/san-pham"
                    class="menu-link"
                >
                    <i class="fa-solid fa-cube"></i>
                    Quản lý sản phẩm
                </a>
            </li>

            <li class="menu-item">
                <a
                    href="/quan-tri/danh-muc"
                    class="menu-link active"
                >
                    <i class="fa-solid fa-layer-group"></i>
                    Quản lý danh mục
                </a>
            </li>

            <li class="menu-item">
                <a
                    href="/quan-tri/don-hang"
                    class="menu-link"
                >
                    <i class="fa-solid fa-clipboard-list"></i>
                    Quản lý đơn hàng
                </a>
            </li>

        </ul>

        <div class="sidebar-line"></div>

        <ul class="menu">
            <li class="menu-item">
                <a
                    href="/dang-xuat"
                    class="menu-link"
                >
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Đăng xuất
                </a>
            </li>
        </ul>

    </aside>


    <!-- MAIN -->
    <div class="main">

        <div class="topbar">

            <div class="admin-user">

                <div class="admin-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>

                <span>
                    <%= nguoiDung
                        ? nguoiDung.hoTen
                        : "Admin"
                    %>
                </span>

            </div>

        </div>


        <div class="content">

            <h1 class="page-title">
                Sửa danh mục
            </h1>

            <div class="page-subtitle">
                Cập nhật thông tin và hình ảnh danh mục bánh.
            </div>


            <div class="form-box">

                <form
                    action="/quan-tri/danh-muc/sua/<%= danhMuc._id %>"
                    method="POST"
                    enctype="multipart/form-data"
                >

                    <!-- TÊN -->
                    <div class="mb-4">

                        <label class="form-label">
                            Tên danh mục
                        </label>

                        <input
                            type="text"
                            name="tenDanhMuc"
                            class="form-control"
                            value="<%= danhMuc.tenDanhMuc %>"
                            required
                        >

                    </div>


                    <!-- ẢNH HIỆN TẠI -->
                    <div class="mb-4">

                        <label class="form-label">
                            Hình ảnh danh mục
                        </label>

                        <% if (danhMuc.hinhAnh) { %>

                            <div>
                                <div class="image-title">
                                    Ảnh hiện tại
                                </div>

                                <img
                                    src="<%= danhMuc.hinhAnh %>"
                                    alt="<%= danhMuc.tenDanhMuc %>"
                                    class="current-image"
                                    id="previewImage"
                                >
                            </div>

                        <% } else { %>

                            <div>
                                <img
                                    src=""
                                    alt="Ảnh xem trước"
                                    class="current-image"
                                    id="previewImage"
                                    style="display:none;"
                                >
                            </div>

                        <% } %>


                        <div class="mt-3">

                            <label class="form-label">
                                Chọn ảnh mới
                            </label>

                            <input
                                type="file"
                                name="hinhAnh"
                                class="form-control"
                                accept=".jpg,.jpeg,.png,.webp"
                                onchange="xemTruocAnh(event)"
                            >

                            <small class="text-secondary">
                                Không chọn ảnh mới nếu muốn giữ ảnh hiện tại.
                            </small>

                        </div>

                    </div>


                    <!-- MÔ TẢ -->
                    <div class="mb-4">

                        <label class="form-label">
                            Mô tả
                        </label>

                        <textarea
                            name="moTa"
                            class="form-control"
                        ><%= danhMuc.moTa || "" %></textarea>

                    </div>


                    <!-- TRẠNG THÁI -->
                    <div class="mb-4">

                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select
                            name="trangThai"
                            class="form-select"
                        >

                            <option
                                value="true"
                                <%= danhMuc.trangThai ? "selected" : "" %>
                            >
                                Hoạt động
                            </option>

                            <option
                                value="false"
                                <%= !danhMuc.trangThai ? "selected" : "" %>
                            >
                                Ngừng hoạt động
                            </option>

                        </select>

                    </div>


                    <!-- BUTTON -->
                    <div class="button-group">

                        <button
                            type="submit"
                            class="btn-save"
                        >
                            <i class="fa-solid fa-floppy-disk me-2"></i>
                            Lưu thay đổi
                        </button>

                        <a
                            href="/quan-tri/danh-muc"
                            class="btn-back"
                        >
                            <i class="fa-solid fa-arrow-left me-2"></i>
                            Quay lại
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<script>
function xemTruocAnh(event) {

    const file = event.target.files[0];
    const preview =
        document.getElementById("previewImage");

    if (!file) {
        return;
    }

    preview.src =
        URL.createObjectURL(file);

    preview.style.display = "block";
}
</script>

</body>
</html>